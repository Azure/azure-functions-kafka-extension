{
  "scriptFile": "index.js",
  "bindings": [
    {
      "type": "kafkaTrigger",
      "name": "event",
      "direction": "in",
      "brokerList": "ConfluentBrokerList",
      "topic": "e2e-kafka-javascript-single-confluent",
      "consumerGroup": "$Default",
      "dataType": "string"
    },
    {
      "type": "queue",
      "direction": "out",
      "name": "queueMsg",
      "queueName": "e2e-javascript-single-confluent",
      "connection": "AzureWebJobsStorage"
    }
  ]
}