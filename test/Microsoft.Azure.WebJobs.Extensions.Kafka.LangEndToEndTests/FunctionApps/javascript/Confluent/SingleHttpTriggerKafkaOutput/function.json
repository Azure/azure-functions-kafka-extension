{
  "scriptFile": "index.js",
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "get",
        "post"
      ]
    },
    {
      "type": "kafka",
      "direction": "out",
      "name": "out",
      "brokerList": "ConfluentBrokerList",
      "topic": "e2e-kafka-javascript-single-confluent"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    }
  ]
}