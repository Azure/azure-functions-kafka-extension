{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/azure-functions-kafka-extension/test/CompatibilityHarness/manifest.schema.json",
  "title": "Kafka extension compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "qualificationMode",
    "host",
    "worker",
    "javaAdditions",
    "languageLibrary",
    "kafkaExtension",
    "broker",
    "buildTooling"
  ],
  "$defs": {
    "gitComponent": {
      "type": "object",
      "required": ["source", "repository", "commit"],
      "properties": {
        "source": { "const": "git" },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/Azure/.+\\.git$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "digestImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "qualificationMode": { "enum": ["development", "release"] },
    "host": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["runtimeImage"],
          "properties": {
            "runtimeImage": { "$ref": "#/$defs/digestImage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "worker": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "const": "java" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "javaAdditions": {
      "allOf": [{ "$ref": "#/$defs/gitComponent" }],
      "unevaluatedProperties": false
    },
    "languageLibrary": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["language", "version"],
          "properties": {
            "language": { "const": "java" },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "kafkaExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "repository", "ref"],
      "properties": {
        "source": { "const": "workspace" },
        "repository": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "image"],
      "properties": {
        "kind": { "const": "local-kafka" },
        "source": { "const": "container" },
        "image": { "$ref": "#/$defs/digestImage" }
      }
    },
    "buildTooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "javaAdditionsImage", "javaImage", "dotnetSdkImage"],
      "properties": {
        "source": { "const": "container" },
        "javaAdditionsImage": { "$ref": "#/$defs/digestImage" },
        "javaImage": { "$ref": "#/$defs/digestImage" },
        "dotnetSdkImage": { "$ref": "#/$defs/digestImage" }
      }
    }
  }
}
