{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/azure-functions-kafka-extension/test/CompatibilityHarness/manifest.schema.json",
  "title": "Kafka extension compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "qualificationMode",
    "host",
    "worker",
    "javaAdditions",
    "languageLibrary",
    "kafkaExtension",
    "broker",
    "functionApp",
    "packageFeeds",
    "toolchains",
    "buildTooling"
  ],
  "$defs": {
    "gitComponent": {
      "type": "object",
      "required": ["source", "repository", "commit"],
      "properties": {
        "source": { "const": "git" },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/Azure/.+\\.git$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "digestImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "qualificationMode": { "enum": ["development", "release"] },
    "host": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["runtimeImage"],
          "properties": {
            "runtimeImage": { "$ref": "#/$defs/digestImage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "worker": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "const": "java" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "javaAdditions": {
      "allOf": [{ "$ref": "#/$defs/gitComponent" }],
      "unevaluatedProperties": false
    },
    "languageLibrary": {
      "allOf": [
        { "$ref": "#/$defs/gitComponent" },
        {
          "type": "object",
          "required": ["language", "version"],
          "properties": {
            "language": { "const": "java" },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "kafkaExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "repository", "ref"],
      "properties": {
        "source": { "const": "workspace" },
        "repository": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "image"],
      "properties": {
        "kind": { "const": "local-kafka" },
        "source": { "const": "container" },
        "image": { "$ref": "#/$defs/digestImage" }
      }
    },
    "functionApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "javaVersion",
        "compilerRelease",
        "azureFunctionsMavenPluginVersion",
        "mavenCompilerPluginVersion"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "javaVersion": { "type": "string", "pattern": "^\\d+$" },
        "compilerRelease": { "type": "string", "pattern": "^\\d+$" },
        "azureFunctionsMavenPluginVersion": { "type": "string", "minLength": 1 },
        "mavenCompilerPluginVersion": { "type": "string", "minLength": 1 }
      }
    },
    "packageFeeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "azureDevOpsResource", "nuget", "maven"],
      "properties": {
        "policy": { "const": "cfs-only" },
        "azureDevOpsResource": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        },
        "nuget": {
          "type": "string",
          "const": "https://pkgs.dev.azure.com/azfunc/public/_packaging/upstream-public/nuget/v3/index.json"
        },
        "maven": {
          "type": "string",
          "const": "https://pkgs.dev.azure.com/azfunc/public/_packaging/upstream-public/maven/v1"
        }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javaAdditions",
        "javaWorker",
        "mavenAdditions",
        "mavenWorker",
        "dotnetSdk"
      ],
      "properties": {
        "javaAdditions": { "type": "string", "minLength": 1 },
        "javaWorker": { "type": "string", "minLength": 1 },
        "mavenAdditions": { "type": "string", "minLength": 1 },
        "mavenWorker": { "type": "string", "minLength": 1 },
        "dotnetSdk": { "type": "string", "minLength": 1 }
      }
    },
    "buildTooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "javaAdditionsImage", "javaImage", "dotnetSdkImage"],
      "properties": {
        "source": { "const": "container" },
        "javaAdditionsImage": { "$ref": "#/$defs/digestImage" },
        "javaImage": { "$ref": "#/$defs/digestImage" },
        "dotnetSdkImage": { "$ref": "#/$defs/digestImage" }
      }
    }
  }
}
